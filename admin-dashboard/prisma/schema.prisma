// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:1234@localhost:5432/payment_bot"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── User: Telegram user linked by phone number ─────────────────────

model User {
  id              Int       @id @default(autoincrement())
  telegramId      BigInt    @unique @map("telegram_id")
  phone           String    @unique
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  username        String?
  registeredAt    DateTime  @default(now()) @map("registered_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Group: Class / Group profile ───────────────────────────────────

model Group {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  course          String?
  teacher         String?
  branch          String?
  room            String?
  startTime       String?   @map("start_time")
  endTime         String?   @map("end_time")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  activeStudents  Int       @default(0) @map("active_students")
  monthlyFee      Float     @default(550000) @map("monthly_fee")
  status          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("groups")
}

// ─── Student: Flat student profile matching Excel ───────────────────

model Student {
  id              Int       @id @default(autoincrement())
  excelId         Int?      @map("excel_id")
  fullName        String    @map("full_name")
  score           Float?
  phone           String    @unique
  note            String?
  groupName       String?   @map("group_name")
  classTime       String?   @map("class_time")
  teacher         String?
  nextPaymentInfo String?   @map("next_payment_info")
  groupBalance    Float?    @map("group_balance")
  studentBalance  Float?    @map("student_balance")
  status          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  payments        Payment[]

  @@map("students")
}

// ─── Payment: payment records with status tracking ──────────────────

model Payment {
  id                    Int           @id @default(autoincrement())
  studentId             Int           @map("student_id")
  amount                Int           // in UZS
  currency              String        @default("UZS")
  status                PaymentStatus @default(PENDING)
  telegramPaymentId     String?       @unique @map("telegram_payment_id")
  providerPaymentId     String?       @map("provider_payment_id")
  paymentMonth          String        @map("payment_month") // e.g. "2026-07" (year-month)
  description           String?
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  student               Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, paymentMonth])
  @@index([status])
  @@map("payments")
}

// ─── Admin: dashboard administrator ─────────────────────────────────

model Admin {
  id              Int       @id @default(autoincrement())
  phone           String    @unique
  password        String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

