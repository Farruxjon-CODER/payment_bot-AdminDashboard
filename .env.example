# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Payment Provider Token (from @BotFather → Payments)
PROVIDER_TOKEN=YOUR_PROVIDER_TEST_OR_LIVE_TOKEN_HERE

# PostgreSQL Database URL
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Admin Telegram Chat ID (receives real-time payment notifications)
ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID

# Director Telegram Chat ID (receives daily/monthly reports)
DIRECTOR_CHAT_ID=YOUR_DIRECTOR_CHAT_ID